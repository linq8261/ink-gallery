<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        三处必须共用同一个色值，否则冷启动首帧上屏的一瞬会颜色跳变：
        1. Theme.InkGallery.Starting 的 windowSplashScreenBackground（启动窗口）
        2. Theme.InkGallery 的 android:windowBackground / 系统栏底色（Activity 窗口底色）
        3. Compose 的 colorScheme.background / surface（见 ui/theme/Theme.kt）
        值 = 水墨风宣纸白，与 Theme.kt 的 InkPaper 一致。
    -->
    <color name="ink_background">#FFF4F0E4</color>
</resources>
